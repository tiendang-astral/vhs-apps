# Sao chép thành .env rồi sửa các giá trị dưới đây
# Chuỗi kết nối SQL Server (lấy từ backend/VNEB/appsettings.Local.json)
DB_CONNECTION=Server=103.176.179.125,1433;uid=sa;pwd=doi-mat-khau;database=ManagementDB;TrustServerCertificate=True
# Khóa ký JWT (>= 32 ký tự). Phải GIỐNG khóa đang dùng, nếu không mọi người bị đăng xuất.
JWT_SECRET=thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
# URL công khai của web (nginx web chuyển /api sang API) — nhúng vào frontend lúc build, đổi thì phải build lại web
API_URL=https://erp.erpunicore.vn
# URL công khai của frontend, cho CORS (để trống = cho phép mọi domain)
FRONTEND_URL=https://erp.erpunicore.vn
API_PORT=10084
WEB_PORT=10083
# URL trang hub — hiện nút nổi quay về hub (trống = ẩn)
HUB_URL=https://apps.erpunicore.vn
