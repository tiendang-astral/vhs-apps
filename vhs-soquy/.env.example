# Sao chép thành ../env/vhs-soquy/.env (hoặc .env.dev) rồi sửa các giá trị dưới đây
POSTGRES_PASSWORD=doi-mat-khau-csdl
# Chuỗi bí mật ký phiên đăng nhập (>= 32 ký tự ngẫu nhiên). Tạo: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
# Tài khoản Quản trị hệ thống tạo lần đầu (đổi mật khẩu ngay sau khi đăng nhập)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi-mat-khau-admin
ADMIN_FULLNAME=Quản trị hệ thống
# 0 = bắt đầu trắng, kế toán nhập liệu mới (mặc định); 1 = nạp dữ liệu mẫu từ Excel cũ (chỉ để chạy thử)
SEED_LEGACY=0
TOKEN_HOURS=12
# Ngưỡng N mặc định (đồng): khoản chi lớn hơn N cần KSNB kiểm trước + Chủ tịch duyệt. Đặt riêng từng nhóm trong Dữ liệu khai báo → Nhóm công ty
APPROVAL_THRESHOLD=200000000
APP_PORT=8000
# URL trang hub (trống = ẩn nút về hub)
HUB_URL=https://hub.example.com
